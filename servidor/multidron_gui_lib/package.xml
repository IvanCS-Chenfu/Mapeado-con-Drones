<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multidron_gui_lib</name>
  <version>0.1.0</version>
  <description>Librería de modelo, bridge ROS 2 y render Qt/OpenGL de la GUI multi-dron de Fase 7.</description>
  <maintainer email="ivancalvosantos2003@uma.es">Ivan Calvo Santos</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>orbslam3_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- Dependencias de sistema habituales para Qt5; CMake admite también Qt6. -->
  <build_depend>qtbase5-dev</build_depend>
  <build_depend>libqt5opengl5-dev</build_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
